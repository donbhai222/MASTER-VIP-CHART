<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0">
    <title>MASTER VIP CHART</title>
    <style>
        :root { --dark-blue: #1a024d; --gold: #FFD700; --vip-red: #e31e24; }
        body { background: #FFBF82; font-family: sans-serif; text-align: center; margin: 0; padding-bottom: 50px; }
        
        .header { background: var(--dark-blue); padding: 10px; border-bottom: 3px solid var(--gold); }
        .header h1 { margin: 0; font-size: 18px; color: var(--gold); text-transform: uppercase; }

        /* 4 Line Description */
        .special-note { background: #fff; padding: 12px; margin: 10px auto; width: 90%; border-left: 5px solid var(--vip-red); border-radius: 4px; text-align: left; }
        .special-note ul { margin: 5px 0 0 0; padding-left: 15px; font-size: 12px; color: #555; }

        /* Master VIP Highlight Style */
        .master-vip-box {
            background: #000;
            margin: 15px auto;
            width: 90%;
            padding: 15px;
            border: 2px solid var(--gold);
            border-radius: 10px;
            box-shadow: 0 0 15px var(--gold);
            animation: glow 1.5s infinite alternate;
        }
        @keyframes glow {
            from { box-shadow: 0 0 5px var(--gold); }
            to { box-shadow: 0 0 20px var(--gold); }
        }
        .vip-title { color: var(--gold); font-size: 14px; font-weight: bold; text-transform: uppercase; margin-bottom: 5px; }
        .vip-result { color: #fff; font-size: 32px; font-weight: 900; letter-spacing: 2px; }

        /* Live Market Section */
        #liveResults { background: #fff; margin: 10px auto; width: 90%; border: 2px solid var(--vip-red); border-radius: 5px; padding: 10px; }
        #liveDataContainer { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px; }
        .live-item { background: #fdf2f2; padding: 6px; border-radius: 3px; border: 1px solid #ddd; }
        
        /* Chart Styles */
        #chartWrapper { width: 90%; margin: 10px auto; background: #fff; border: 1px solid #000; overflow-x: auto; }
        table { border-collapse: collapse; width: 100%; min-width: 300px; }
        th { background: #ffff00; font-size: 10px; padding: 6px; border: 1px solid #000; }
        td { border: 1px solid #000; height: 40px; text-align: center; }
        .btn-pay-main { background: var(--vip-red); color: white; padding: 12px; border: none; border-radius: 6px; width: 90%; font-weight: bold; margin: 10px 0; cursor: pointer; }
    </style>
</head>
<body>

<div class="header"><h1>MASTER VIP CHART</h1></div>

<div class="special-note">
    <p><strong>विशेष सूचना:</strong> मास्टर VIP चार्ट में आपका स्वागत है।</p>
    <ul>
        <li>सबसे तेज़ और सटीक गेम रिजल्ट यहाँ उपलब्ध है।</li>
        <li>हमारे एक्सपर्ट्स द्वारा तैयार नंबरों का लाभ उठाएं।</li>
        <li>100% भरोसेमंद और सुरक्षित सर्विस का अनुभव करें।</li>
        <li>आज ही VIP मेंबर बनें और जीत की शुरुआत करें।</li>
    </ul>
</div>

<!-- Master VIP Result Section -->
<div class="master-vip-box">
    <div class="vip-title">MASTER VIP CHART RESULT</div>
    <div class="vip-result" id="vipResultVal">---</div>
</div>

<!-- Live Market Section -->
<div id="liveResults">
    <h3 style="margin: 0; color: var(--vip-red); font-size: 16px;">LIVE MARKET RESULTS</h3>
    <div id="liveDataContainer"></div>
</div>

<div id="chartWrapper">
    <table>
        <thead>
            <tr><th>DATE</th><th>MON</th><th>TUE</th><th>WED</th><th>THU</th><th>FRI</th><th>SAT</th></tr>
        </thead>
        <tbody id="gridData"></tbody>
    </table>
</div>

<button class="btn-pay-main" onclick="openVipModal()">JOIN VIP / लॉक खोलें 🔑</button>

<script>
    const CHART_CSV = "https://docs.google.com/spreadsheets/d/1Oh9iZHT-QAhSTHDhP36qdqX38ZYJ-eivfr1VtyOExJA/export?format=csv&gid=0";
    const LIVE_CSV = "https://docs.google.com/spreadsheets/d/1Oh9iZHT-QAhSTHDhP36qdqX38ZYJ-eivfr1VtyOExJA/export?format=csv&gid=1914363886";

    async function loadData() {
        // Live Results
        fetch(LIVE_CSV + "&cache=" + Date.now()).then(r => r.text()).then(data => {
            const rows = data.split('\n').filter(r => r.trim() !== '');
            let html = '';
            rows.forEach((row, index) => {
                let cols = row.split(',');
                if(index === 0) {
                    document.getElementById('vipResultVal').innerText = cols[1];
                } else if(cols.length >= 2) {
                    html += `<div class="live-item"><div style="font-size:9px; font-weight:bold;">${cols[0]}</div><div style="font-size:14px; color:red; font-weight:900;">${cols[1]}</div></div>`;
                }
            });
            document.getElementById('liveDataContainer').innerHTML = html;
        });

        // Chart Data
        fetch(CHART_CSV + "&cache=" + Date.now()).then(r => r.text()).then(data => {
            const rows = data.split('\n').filter(r => r.trim() !== '');
            let html = '';
            for(let i=1; i<rows.length; i++) {
                let cols = rows[i].split(',');
                html += `<tr><td style="background:#f0f0f0; font-size:9px;">${cols[0]}</td>`;
                for(let j=1; j<cols.length; j++) html += `<td>${cols[j] || ''}</td>`;
                html += `</tr>`;
            }
            document.getElementById('gridData').innerHTML = html;
        });
    }
    window.onload = loadData;
</script>
</body>
</html>
